      "condition": { "mailMode": [ "Auto" ] },
      "categories": [],
      "capabilities": [ "reportSubscriptions" ],
      "docs": {
        "title": "Dedicated sender mailbox",
        "why": "A shared mailbox created solely to send scheduled reports from, so the scanner never needs permission on a real user's mailbox.",
