      "role": "Application Mail.Send",
      "scope": { "type": "managementScope", "name": "M365Permissions-Sender", "source": "context:mailAddress" },
      "condition": { "mailMode": [ "Auto", "Existing" ] },
      "categories": [],
      "capabilities": [ "reportSubscriptions" ],
      "docs": {
        "title": "Exchange: send as one mailbox only",
        "why": "Sends scheduled reports from exactly one designated mailbox. This is what makes the tenant-wide Graph Mail.Send permission unnecessary.",
        "url": "https://m365permissions.com/docs/permissions#exo.mail.send.scoped"
      }
