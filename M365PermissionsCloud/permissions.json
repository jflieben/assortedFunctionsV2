    {
      "key": "fabric.readonly.adminapis",
      "nodeScoped": false,
      "principal": "scanner",
      "provider": "fabricTenantSetting",
      "necessity": "recommended",
      "settingMatch": [ "service principals can use read-only", "service principals can access read-only" ],
      "settingName": "AllowServicePrincipalsUseReadAdminAPIs",
      "groupRef": "service",
      "condition": { "surfaces": "PowerBI" },
      "categories": [ "PowerBI" ],
      "docs": {
        "title": "Fabric: service principals may use read-only admin APIs",
        "why": "A Fabric tenant setting, not an Entra permission. Without it every Power BI admin API returns 401 no matter which Entra permissions are held. The onboarding script switches it on and delegates it to the service group, so this is no longer a manual step. It needs a Fabric administrator, so if the person running onboarding is not one, it is reported and skipped rather than failing the run.",
        "url": "https://m365permissions.com/docs/scanning-powerbi"
      }
    },
    {
      "key": "devops.org.user",
      "principal": "scanner",
      "provider": "azureDevOpsOrgUser",
