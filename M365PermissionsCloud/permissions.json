    {
      "key": "exo.rbac.viewonly.recipients",
      "principal": "scanner",
      "provider": "exoRoleAssignment",
      "necessity": "recommended",
      "role": "View-Only Recipients",
      "condition": { "surfaces": "Exchange" },
      "categories": [ "ExoRecipients"],
      "docs": {
