    { "key": "Exchange",      "displayName": "Exchange Online",  "default": true,  "description": "Mailboxes, mail-enabled groups, calendar and folder permissions." },
    { "key": "PowerBI",       "displayName": "Power BI / Fabric","default": false, "description": "Workspaces, reports, datasets and their permissions." },
    { "key": "PowerPlatform", "displayName": "Power Platform",   "default": false, "description": "Environments, apps and flows. Authorized manually, see the docs link." },
    { "key": "AzureDevOps",   "displayName": "Azure DevOps",     "default": false, "description": "Organizations, projects and group memberships." },
    { "key": "Azure",         "displayName": "Azure",            "default": false, "description": "Subscription and resource group RBAC assignments." }
  ],

