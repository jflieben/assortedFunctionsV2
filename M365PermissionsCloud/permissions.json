      "condition": { "surfaces": "Exchange" },
      "categories": [ "Admins", "ExoRecipients" ],
      "docs": {
        "title": "Exchange: View-Only Configuration",
        "why": "Reads Exchange role groups, management roles and role assignments, which is what the administrator report needs. Read-only.",
        "url": "https://m365permissions.com/docs/permissions#exo.rbac.viewonly.configuration"
      }
    },
    {
      "key": "exo.mailbox.sender",
      "nodeScoped": false,
      "principal": "scanner",
      "provider": "exoMailbox",
